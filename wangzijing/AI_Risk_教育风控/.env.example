# 复制为 .env 后填写本机配置；.env 已被 .gitignore 排除。
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=ai_risk_education
TEST_DB_NAME=ai_risk_education_test

# 登录会话密钥：正式部署时请替换为随机长字符串。
AUTH_SECRET_KEY=please-change-this-to-a-long-random-secret
AUTH_COOKIE_NAME=edu_guard_session
AUTH_SESSION_HOURS=8
AUTH_COOKIE_SECURE=false

# 第二阶段不需要调用大模型，密钥保持为空。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# 教育版模型已训练；若只想演示纯规则链路可改为 false。
XGB_ENABLED=true
