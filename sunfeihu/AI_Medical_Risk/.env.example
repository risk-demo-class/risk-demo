# MySQL 8.x（复制为 .env 后填写本机值）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_risk_medical
TEST_DB_NAME=ai_risk_medical_test

# P3 可选：无 Key 时规则和模型主流程仍可运行
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# 本地服务与定时告警
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SESSION_SECRET=please-change-this-long-random-value
SESSION_MAX_AGE_SECONDS=28800
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
ALERT_SCHEDULER_ENABLED=true
ALERT_INTERVAL_SECONDS=300
ALERT_PENDING_CASE_THRESHOLD=5
ALERT_HIGH_RISK_RATE_THRESHOLD=0.60
ALERT_DOCTOR_AMOUNT_THRESHOLD=100000
ALERT_HOSPITAL_CLAIM_THRESHOLD=200000
