# 银行风控教学项目 .env.example
# 复制为 .env 并按需填写。.env 已被 .gitignore 忽略，绝不提交真实凭据。
# 用法 (Windows PowerShell): Copy-Item .env.example .env

# ---- 数据库（本机开发示例：Docker MySQL 容器映射到 127.0.0.1:33307，root 空密码）----
DB_HOST=127.0.0.1
DB_PORT=33307
DB_USER=root
DB_PASSWORD=
DB_NAME=bank_risk
TEST_DB_NAME=bank_risk_test

# ---- XGBoost ----
XGB_MODEL_PATH=app/engine/xgb_model.json
XGB_ENABLED=true

# ---- AI 风控助手（阿里云百炼 OpenAI 兼容；不填则助手降级提示）----
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ---- 后台调度与告警阈值（可选，与 docker/.env.example 一致）----
CASE_TIMEOUT_HOURS=24
ALERT_SCHEDULER_INTERVAL_MIN=15
ALERT_PENDING_CASE_THRESHOLD=50
ALERT_CHECK_WINDOW_HOURS=1
