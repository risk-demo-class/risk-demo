# =============================================================================
# .env.example (P4-L3 + P4-L4 2026-08-08)
# 位置: docker/.env.example
# 复制为 .env 并填真实值 (生产用, 不要 commit .env)
# 用法: cp docker/.env.example docker/.env
# ⚠️ 生产必须改成强随机密码, 不要沿用示例值
# =============================================================================

# ---- 数据库 (跟 docker-compose.yml 的 MySQL service 一致) ----
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=ecs
MYSQL_PORT=3306
DB_HOST=mysql        # docker-compose 里用 service 名; 本机开发用 localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me-strong-password
DB_NAME=ecs
TEST_DB_NAME=ecs_test

# ---- 阿里云百炼 LLM (生产填真实 key, 没填 Agent 功能降级) ----
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ---- 登录鉴权 (2026-08-11) ----
# 管理接口 (规则/黑名单/案件审核/AI 助手) 需要登录后调用
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password
# Token 签名密钥: 建议 32+ 位随机串; 留空则用 ADMIN_PASSWORD 派生
AUTH_SECRET=change-me-random-secret
AUTH_TOKEN_TTL_HOURS=8

# ---- 后台调度 (P4-L3 新增) ----
# 待审案件超 N 小时自动关案, 默认 24h; 0 = 关闭
CASE_TIMEOUT_HOURS=24
# 告警检查间隔 (分钟), 默认 15; 0 = 关闭 (只能手动 POST /api/alerts/check)
ALERT_SCHEDULER_INTERVAL_MIN=15

# ---- 告警阈值 (P4-L2) ----
ALERT_PENDING_CASE_THRESHOLD=50
ALERT_CHECK_WINDOW_HOURS=1

# ---- 端口映射 ----
APP_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443
