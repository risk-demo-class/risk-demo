# 复制为 docker/.env 并填真实值，不要提交实际密钥。

# ---- 数据库 (跟 docker-compose.yml 的 MySQL service 一致) ----
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=logistics_risk
MYSQL_PORT=3306
DB_HOST=mysql        # docker-compose 里用 service 名; 本机开发用 localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=logistics_risk
TEST_DB_NAME=logistics_risk_test

# ---- 物流 XGBoost 模型 ----
XGB_ENABLED=true
XGB_MODEL_PATH=app/engine/xgb_model.json
XGB_TRAIN_DATA_LIMIT=5000

# ---- 阿里云百炼 LLM (生产填真实 key, 没填 Agent 功能降级) ----
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ---- 后台调度 (P4-L3 新增) ----
# 待审案件超 N 小时自动关案, 默认 24h; 0 = 关闭
CASE_TIMEOUT_HOURS=24
# 告警检查间隔 (分钟), 默认 15; 0 = 关闭 (只能手动 POST /api/alerts/check)
ALERT_SCHEDULER_INTERVAL_MIN=15

# ---- 告警阈值 (P4-L2) ----
ALERT_PENDING_CASE_THRESHOLD=50
ALERT_CHECK_WINDOW_HOURS=1

# ---- 端口映射 ----
APP_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443
