# =========================================================
# 教育知识库（教育实战）环境变量示例
# 复制本文件为 .env 后填写真实配置
# =========================================================

# ====================
# MinerU API（PDF -> Markdown 结构化解析，可选项）
# ====================
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4

# ====================
# OpenAI / LLM API（阿里云 DashScope 兼容模式）
# ====================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型（用于 Markdown 图片摘要）
VL_MODEL=qwen3-vl-flash
# 意图识别 / 元数据识别模型
ITEM_MODEL=qwen-flash

# ====================
# 对象存储 MinIO（可选，用于图片托管）
# ====================
MINIO_ENDPOINT=192.168.100.100:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=edu-knowledge-base
MINIO_IMG_DIR=upload-images

# ====================
# 文档切分参数
# ====================
DEFAULT_MAX_CONTENT_LENGTH=1200
DEFAULT_MIN_CONTENT_LENGTH=200
DEFAULT_WINDOW_OVERLAP=100

# ====================
# BGE-M3 向量模型
# ====================
BGE_M3_PATH=BAAI/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0

# ====================
# Milvus 向量数据库
# ====================
MILVUS_URL=http://192.168.100.100:19530
# 教育知识库专用集合
EDU_CHUNKS_COLLECTION=edu_chunks
EDU_COURSES_COLLECTION=edu_courses
EDU_QUESTIONS_COLLECTION=edu_questions
EDU_ENTITIES_COLLECTION=edu_entities

# ====================
# MongoDB（对话历史）
# ====================
MONGO_URL=mongodb://192.168.100.100:27017
MONGO_DB_NAME=edu_knowledge_base

# ====================
# 联网搜索 MCP（可选，通过阿里云百炼 Web Search）
# ====================
MCP_DASHSCOPE_BASE_URL=

# ====================
# Rerank 重排序（可选，通过 DashScope）
# ====================
OPENAI_BASE_URL_DASHSCOPE=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_RERANK_MODEL=gte-rerank-v2
TEXT_RERANK_INSTRUCT=true

# ====================
# 上传文件落地目录（导入工作流的工作目录）
# ====================
DATA_BASED_ROOT_DIR=D:/edu_data
