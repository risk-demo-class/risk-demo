# ============ 基础 ============
APP_ENV=dev
DEBUG=true

# ============ 数据库 ============
# mysql(生产) / sqlite(测试/本地快速跑, 无需安装数据库)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=edu_risk
DB_CHARSET=utf8mb4

# ============ 决策阈值 ============
RISK_PASS_THRESHOLD=30
RISK_MARK_THRESHOLD=60
RISK_REVIEW_THRESHOLD=80
RISK_VETO_MIN_SCORE=90

# ============ 双轨融合 ============
ML_WEIGHT_RULE=0.5
ML_WEIGHT_XGB=0.5

# ============ 案件 ============
CASE_TIMEOUT_HOURS=24
ALERT_SCHEDULER_INTERVAL_MIN=15

# ============ XGBoost ============
XGB_ENABLED=true
XGB_MODEL_PATH=models/xgb_model.json

# 训练 4 必做
XGB_TEST_SIZE=0.2
XGB_EARLY_STOPPING_ROUNDS=10
XGB_MIN_SAMPLES=1250
XGB_MAX_SCALE_POS_WEIGHT=10.0

# 5 件套抗假收敛
XGB_EARLY_STOP_METRIC=auc
XGB_WARMUP_ROUNDS=50
XGB_REG_ALPHA=0.1
XGB_REG_LAMBDA=1.0
XGB_MIN_CHILD_WEIGHT=3
XGB_SUBSAMPLE=0.8
XGB_COLSAMPLE_BYTREE=0.8

# 假收敛检测
XGB_MIN_BEST_ITER=30
XGB_MIN_VAL_AUC=0.70
XGB_MIN_VAL_F1=0.50

# ============ AI Agent ============
LLM_API_KEY=sk-ws-H.EDRRMMR.PLoZ.MEYCIQDX0_O5wkofVizMXx3_9mUGlXavmLruCdBAZhmz3vqNywIhAIaZ_dzgRm4Foj4hoJkXp9sK3ftw4f4ag2GSoBPnTFIb
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
AI_AGENT_CHAT_TIMEOUT_SEC=60
