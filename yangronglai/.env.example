# BankRisk-AI 本地开发配置。复制为 .env 后再启动。
APP_NAME=BankRisk-AI
APP_VERSION=1.0.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
LOG_LEVEL=INFO
# JSON 日志按天轮转并保留 30 天；生产环境密钥必须由密钥系统注入。
LOG_RETENTION_DAYS=30
LOG_PSEUDONYM_KEY=replace_with_at_least_32_random_characters
# 可选：ERROR/CRITICAL 同步发送到告警平台 webhook；未配置时仍写 alerts.log。
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=2

# 客户申诉：签名密钥用于签发限时申诉凭证；内部复议令牌必须由权限系统注入。
APPEAL_SIGNING_KEY=replace_with_at_least_32_random_characters
APPEAL_WINDOW_DAYS=30
APPEAL_REVIEW_SLA_DAYS=7
APPEAL_REVIEW_TOKEN=replace_via_internal_approval_system

# 本地默认使用 SQLite，开箱即用；Docker/生产环境切换为 mysql。
DB_DRIVER=sqlite
SQLITE_PATH=data/bankrisk.db
AUTO_INIT_DB=true
SEED_DEMO_DATA=true

# MySQL（DB_DRIVER=mysql 时生效；生产环境请由密钥系统注入）
DB_HOST=localhost
DB_PORT=3306
DB_USER=bankrisk
DB_PASSWORD=change_me_before_use
MYSQL_ROOT_PASSWORD=change_root_password_before_use
DB_NAME=bankrisk
TEST_DB_NAME=bankrisk_test

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_before_use
NEO4J_DATABASE=neo4j

# LLM / Agent（当前阶段默认关闭）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# 分阶段启用。当前已完成数据层与规则层。
ENABLE_RULE_ENGINE=true
# 多规则聚合：最高分全额计入，其余规则分数乘此权重。
RULE_ADDITIONAL_WEIGHT=0.2
ENABLE_MODEL_ENGINE=true
MODEL_DIR=artifacts/models
MODEL_AUTO_TRAIN=true

ENABLE_GRAPH_ENGINE=true
GRAPH_BACKEND=local

# 三层融合：最高层分全额计入，其他层分数乘此权重。
FUSION_ADDITIONAL_WEIGHT=0.15

# local=本地工具编排；llm=OpenAI 兼容工具调用，需要 LLM_API_KEY。
ENABLE_AGENT=true
AGENT_MODE=local
# 生产环境由审批系统注入，不要提交到代码库。
AGENT_APPROVAL_TOKEN=change_via_secret_manager
