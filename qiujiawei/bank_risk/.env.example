# 数据库连接
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123321
DB_NAME=bank_risk

# 测试数据库
TEST_DB_NAME=bank_risk_test

# LLM 配置 (阿里云百炼)
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# XGBoost
XGB_ENABLED=true
XGB_MODEL_PATH=app/engine/xgb_model.json

# 风控阈值
RISK_PASS_THRESHOLD=30
RISK_MARK_THRESHOLD=60
RISK_REVIEW_THRESHOLD=80
RISK_VETO_MIN_SCORE=90

# ML 权重
ML_WEIGHT_RULE=0.5
ML_WEIGHT_XGB=0.5
ML_PASS_THRESHOLD=0.30
ML_MARK_THRESHOLD=0.60
ML_REVIEW_THRESHOLD=0.80

# 训练参数
XGB_MAX_DEPTH=6
XGB_LEARNING_RATE=0.1
XGB_MIN_SAMPLES=1250
XGB_TEST_SIZE=0.2
XGB_EARLY_STOPPING_ROUNDS=10
XGB_WARMUP_ROUNDS=50
XGB_MAX_SCALE_POS_WEIGHT=10.0
XGB_MIN_POS_RATIO=0.15
XGB_MAX_POS_RATIO=0.60
XGB_MIN_BEST_ITER=30
XGB_MIN_VAL_AUC=0.70
XGB_MIN_VAL_F1=0.50
XGB_EARLY_STOP_METRIC=auc
XGB_REG_ALPHA=0.1
XGB_REG_LAMBDA=1.0
XGB_GAMMA=0.1
XGB_SUBSAMPLE=0.8
XGB_COLSAMPLE_BYTREE=0.8
XGB_MIN_CHILD_WEIGHT=3

# 调度器
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=900
CASE_AUTO_CLOSE_HOURS=24

# 告警阈值
ALERT_BACKLOG_THRESHOLD=50
ALERT_RULE_HIT_RATE_MIN=0.05
ALERT_BLACKLIST_HIT_RATE_MAX=0.30

# 应用
APP_PORT=8001
