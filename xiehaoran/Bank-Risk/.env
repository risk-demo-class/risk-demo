# ============================================================
# Bank-Risk 运行配置 (.env)
# 所有值均有默认值, 此处列出以便覆盖. 修改后需重启服务.
# ============================================================

# ---- 数据库 (MySQL + aiomysql) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=bank_risk

# ---- LLM (真实大模型 API, 阿里云百炼 qwen-plus) ----
# ⚠️ 必填: 填入你的 API Key 后 AI 助手方可使用. 留空时其他功能正常, AI 助手返回提示.
LLM_API_KEY=sk-6d7e3fa2c45844188ac2498bc1d8c3c0
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ---- XGBoost 双轨融合 ----
XGB_ENABLED=true
XGB_MODEL_PATH=app/engine/xgb_model.json

# ---- 服务端口 ----
# 由 uvicorn / python -m app 启动, 固定 8010 (避免与基线 AI_Risk 8000 冲突)
