# ─────────────────────────────────────────────
# Logistics Risk - 环境变量配置示例
# 复制为 .env 后填入实际值
# ─────────────────────────────────────────────

# 数据库连接 (MySQL async)
DATABASE_URL=mysql+aiomysql://root:YOUR_PASSWORD@localhost:3306/risk_logistics?charset=utf8mb4

# OpenAI (Agent 对话)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4-turbo

# 模型阈值配置 (app/config.py 也可覆盖)
RISK_THRESHOLD_APPROVE=60
RISK_THRESHOLD_REJECT=90
RISK_THRESHOLD_MANUAL=70

# 企业微信告警 (可选)
WECHAT_WEBHOOK_URL=
