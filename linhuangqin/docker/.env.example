# ─────────────────────────────────────────────
# 物流风控系统 Docker 环境变量模板
# 复制为 docker/.env 使用
# ─────────────────────────────────────────────

# 数据库 (MySQL 8.0)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=risk_logistics

# LLM (OpenAI)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4-turbo

# 风险阈值
RISK_THRESHOLD_REJECT=90
RISK_THRESHOLD_APPROVE=60

# 告警 (企业微信)
WECHAT_WEBHOOK_URL=